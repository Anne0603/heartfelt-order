rules_version = '2';

// ============================================================
// heartfelt-order Firestore 安全規則（完整版 v3）
// 每次新增 collection 都會提供「完整版」規則，直接整份覆蓋貼到
// Firebase Console 上比較不容易貼錯位置，貼上後記得按「發布」。
//
// 角色說明：
//   superadmin — 唯一、固定，最高權限，唯一能核准/異動任何人角色的人
//   admin      — 業務功能全權（訂單/商品/包材/客戶/報表/利潤）+ 可換品牌圖案，
//                但不能碰 Cloudinary 系統設定與成員審核
//   order_staff— 訂單/客戶讀寫、可處理出貨，商品與包材唯讀
//   viewer     — 訂單/客戶/包材/報表/利潤全部唯讀，不能寫入任何東西
//
// publicSettings 說明：
//   這個 collection 存放「不敏感、需要在登入前就顯示」的設定，例如
//   品牌 Logo 網址、Cloudinary Cloud Name / Upload Preset（這些本來就是
//   設計成給前端瀏覽器直接呼叫的公開值，不是密鑰）。任何人都能讀，
//   但只有特定角色能寫。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.token.email);
    }

    function memberExists() {
      return isSignedIn() && exists(memberPath());
    }

    function memberData() {
      return get(memberPath()).data;
    }

    function isActiveMember() {
      return memberExists() && memberData().status == 'active';
    }

    function myRole() {
      return isActiveMember() ? memberData().role : null;
    }

    function hasRole(roles) {
      return isActiveMember() && (myRole() in roles);
    }

    function isSuperadmin() {
      return hasRole(['superadmin']);
    }

    // ---------- 成員 / 待審核申請 ----------
    match /members/{email} {
      // 自己的資料一定看得到；其他已核准成員的資料也能個別用信箱查（用來即時顯示暱稱），
      // 但不能列出完整名單（allow list 還是限超級管理員）。
      allow get: if isSignedIn() && (request.auth.token.email == email || isActiveMember());
      allow list: if isSuperadmin();

      allow create: if isSignedIn()
        && request.auth.token.email == email
        && !exists(memberPath())
        && request.resource.data.status == 'pending'
        && request.resource.data.role == null;

      allow update: if isSuperadmin()
        || (isSignedIn() && request.auth.token.email == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname']));
      allow delete: if isSuperadmin();
    }

    // ---------- 公開設定（登入前就要能讀） ----------
    match /publicSettings/brand {
      allow read: if true;
      allow write: if hasRole(['superadmin', 'admin']);
    }
    match /publicSettings/cloudinary {
      allow read: if true;
      allow write: if isSuperadmin();
    }
    match /publicSettings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- 訂單 ----------
    match /orders/{orderId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      allow create: if hasRole(['superadmin', 'admin', 'order_staff']);
      // 訂單進出貨人員可以編輯/推進狀態，但不能把 voided 改成 true（作廢限管理員以上）
      allow update: if hasRole(['superadmin', 'admin'])
        || (hasRole(['order_staff']) && request.resource.data.voided == resource.data.voided);
      allow delete: if isSuperadmin();
    }

    // ---------- 訂單編號流水號（跟訂單一樣的寫入權限） ----------
    match /counters/{counterId} {
      allow read, write: if hasRole(['superadmin', 'admin', 'order_staff']);
    }

    // ---------- 分類管理（商品/採購與庫存共用） ----------
    match /categories/{categoryId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      allow write: if isSuperadmin();
    }

    // ---------- 商品與庫存（合併版：自製商品/現貨商品/包材/組合包） ----------
    match /units/{unitId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      allow write: if isSuperadmin();
    }

    match /items/{itemId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      // 自製商品的定價由管理員以上決定；其餘類型（現貨/包材）訂單進出貨人員也能建立/編輯
      allow create, update: if hasRole(['superadmin', 'admin'])
        || (hasRole(['order_staff']) && request.resource.data.type in ['resale', 'packaging']);
      allow delete: if isSuperadmin();
    }
    match /itemPurchases/{recId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      allow create: if hasRole(['superadmin', 'admin', 'order_staff']);
      allow update: if hasRole(['superadmin', 'admin']);
      allow delete: if isSuperadmin();
    }
    match /itemUsages/{recId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      allow create: if hasRole(['superadmin', 'admin', 'order_staff']);
      allow update: if hasRole(['superadmin', 'admin']);
      allow delete: if isSuperadmin();
    }
    match /itemStocktakes/{recId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      allow create: if hasRole(['superadmin', 'admin', 'order_staff']);
      allow delete: if isSuperadmin();
    }

    // ---------- 客戶與廠商 ----------
    match /contacts/{contactId} {
      allow read: if hasRole(['superadmin', 'admin', 'order_staff', 'viewer']);
      allow write: if hasRole(['superadmin', 'admin', 'order_staff']);
    }

    // ---------- 營業支出（利潤總覽用） ----------
    match /expenses/{expenseId} {
      allow read: if hasRole(['superadmin', 'admin', 'viewer']);
      allow write: if hasRole(['superadmin', 'admin']);
    }

    // ---------- 操作紀錄（誰、什麼時候、做了什麼；不可修改/刪除，保持稽核紀錄完整性） ----------
    match /activityLog/{logId} {
      allow read: if isSuperadmin();
      allow create: if hasRole(['superadmin', 'admin', 'order_staff']);
      allow update, delete: if false;
    }

    // ---------- 其他任何未列出的路徑，一律拒絕 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
